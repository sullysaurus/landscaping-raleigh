---
import BaseLayout from '../layouts/BaseLayout.astro';
import { metricWindow, researchDate, seoTargets } from '../data/seo-tracker';
import gscSnapshot from '../data/gsc-snapshot.json';
import ga4Snapshot from '../data/ga4-snapshot.json';
import scheduledTopics from '../../content-machine/topics.json';
import { getCollection } from 'astro:content';

const buildDate = new Date().toISOString().slice(0, 10);
const generatedIds = new Set((await getCollection('journal')).map((post) => post.id));
const scheduledKeywords = new Set(scheduledTopics.map((topic) => topic.primaryKeyword.toLowerCase()));
const scheduledTargets = scheduledTopics.map((topic) => {
  const isGenerated = generatedIds.has(topic.slug);
  const isLive = isGenerated && topic.publishDate <= buildDate;
  const dateLabel = new Date(`${topic.publishDate}T00:00:00Z`).toLocaleDateString('en-US', {
    month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC',
  });
  return {
    keyword: topic.primaryKeyword,
    volume: topic.volume,
    intent: topic.buyerStage === 'Consideration' ? 'Compare' : 'Learn',
    audience: topic.rationale,
    content: topic.workingTitle,
    url: isLive ? `/journal/${topic.slug}/` : undefined,
    type: 'Scheduled guide',
    status: isLive ? 'Published' : 'Planned',
    nextStep: isGenerated ? `Scheduled for ${dateLabel}` : `Draft and verify before ${dateLabel}`,
  };
});
const trackingTargets = [
  ...seoTargets.filter((target) => !scheduledKeywords.has(target.keyword.toLowerCase())),
  ...scheduledTargets,
];

const counts = {
  published: trackingTargets.filter((item) => item.status === 'Published').length,
  planned: trackingTargets.filter((item) => item.status === 'Planned').length,
  needsInput: trackingTargets.filter((item) => item.status === 'Needs input').length,
};
const gscByKeyword = new Map(gscSnapshot.rows.map((row) => [row.keyword.toLowerCase(), row]));
const rankedCount = trackingTargets.filter((item) => gscByKeyword.has(item.keyword.toLowerCase())).length;
const gscUpdated = gscSnapshot.lastUpdated
  ? new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).format(new Date(gscSnapshot.lastUpdated))
  : 'Not connected yet';
const rankTrend = (change: number | null) => {
  if (change === null || Math.abs(change) < 0.1) return { label: change === null ? 'New ranking' : 'No change', className: 'trend-flat' };
  return change > 0
    ? { label: `Up ${Math.abs(change).toFixed(1)} positions`, className: 'trend-up' }
    : { label: `Down ${Math.abs(change).toFixed(1)} positions`, className: 'trend-down' };
};
const analyticsRows = [
  { label: 'Website visitors', key: 'users', help: 'People who visited the website' },
  { label: 'Visits', key: 'sessions', help: 'Total website visits' },
  { label: 'Pages viewed', key: 'pageViews', help: 'Total pages viewed' },
  { label: 'Google search visits', key: 'organicSessions', help: 'Visits from unpaid Google search' },
  { label: 'Contact forms sent', key: 'formLeads', help: 'Completed contact forms' },
  { label: 'Phone number clicks', key: 'phoneClicks', help: 'Clicks on a phone number' },
  { label: 'Email address clicks', key: 'emailClicks', help: 'Clicks on an email address' },
] as const;
const changeLabel = (current: number, previous: number) => {
  if (current === previous) return 'No change';
  const difference = current - previous;
  return `${difference > 0 ? '+' : ''}${difference.toLocaleString('en-US')}`;
};
const analyticsUpdated = ga4Snapshot.lastUpdated
  ? new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).format(new Date(ga4Snapshot.lastUpdated))
  : 'Waiting for first update';
---

<BaseLayout
  title="SEO Keyword & Content Tracker | Garden & Art Landscapes"
  description="Garden & Art Landscapes keyword, content and Google Search Console tracker."
  noindex
>
  <main class="tracker-page" id="tracker">
    <header class="page-header">
      <div>
        <a href="/">Garden & Art Landscapes</a>
        <h1>SEO content tracker</h1>
      </div>
      <nav aria-label="Tracker links"><a href="/journal/">View Journal</a><a href="/sitemap.xml">View sitemap</a></nav>
    </header>

    <section class="activity-section" aria-labelledby="activity-heading">
      <div class="section-heading">
        <div><h2 id="activity-heading">Website activity</h2><p>Automatically updated from Google Analytics. Latest 28 days compared with the previous 28 days.</p></div>
        <p><strong>Updated:</strong> {analyticsUpdated}</p>
      </div>
      <div class="activity-table-wrap">
        <table class="activity-table">
          <thead><tr><th>What we are measuring</th><th>Latest 28 days</th><th>Previous 28 days</th><th>Change</th></tr></thead>
          <tbody>
            {analyticsRows.map((item) => {
              const current = ga4Snapshot.current[item.key];
              const previous = ga4Snapshot.previous[item.key];
              return <tr><td><strong>{item.label}</strong><small>{item.help}</small></td><td><strong>{current.toLocaleString('en-US')}</strong></td><td>{previous.toLocaleString('en-US')}</td><td><strong class={current > previous ? 'trend-up' : current < previous ? 'trend-down' : 'trend-flat'}>{changeLabel(current, previous)}</strong></td></tr>;
            })}
          </tbody>
        </table>
      </div>
    </section>

    <section class="summary" aria-label="Tracker summary">
      <div><strong>{counts.published}</strong><span>Published</span></div>
      <div><strong>{counts.planned}</strong><span>Planned</span></div>
      <div><strong>{counts.needsInput}</strong><span>Needs client input</span></div>
      <div><strong>{rankedCount}</strong><span>Keywords with Google data</span></div>
      <p><strong>Updated August 3, 2026</strong><br />Search volume: Keywords Everywhere, {researchDate}. Google data: {gscUpdated}.</p>
    </section>

    <section class="table-section">
      <div class="controls" aria-label="Filter keyword tracker">
        <label><span>Find a keyword or page</span><input type="search" placeholder="Type to search…" data-tracker-search /></label>
        <div role="group" aria-label="Filter by status">
          <button class="is-active" type="button" data-filter="All">All ({trackingTargets.length})</button>
          <button type="button" data-filter="Published">Published ({counts.published})</button>
          <button type="button" data-filter="Planned">Planned ({counts.planned})</button>
          <button type="button" data-filter="Needs input">Needs input ({counts.needsInput})</button>
        </div>
      </div>

      <p class="rank-note"><strong>Google rank</strong> is the average Search Console position for the exact keyword during the latest 28-day period. “Up” compares it with the previous 28 days. Search Console normally reports with a two-to-three-day delay.</p>

      <div class="table-wrap">
        <table>
          <thead><tr><th>Keyword</th><th>Current Google rank</th><th>Monthly searches</th><th>Content page</th><th>Status</th><th>{metricWindow}</th><th>Who is searching</th><th>Next step</th></tr></thead>
          <tbody>
            {trackingTargets.map((item) => {
              const metric = gscByKeyword.get(item.keyword.toLowerCase());
              const trend = metric ? rankTrend(metric.positionChange ?? null) : null;
              return (
                <tr data-tracker-row data-status={item.status} data-search={`${item.keyword} ${item.content} ${item.audience}`.toLowerCase()}>
                  <td data-label="Keyword"><strong>{item.keyword}</strong><small>{item.intent} · {item.type}</small></td>
                  <td data-label="Google rank">{metric ? <><strong class="rank-number">#{metric.position.toFixed(1)}</strong><span class={`rank-trend ${trend?.className}`}>{trend?.label}</span>{typeof metric.previousPosition === 'number' && <small>Previous: #{metric.previousPosition.toFixed(1)}</small>}</> : <><strong class="rank-number rank-empty">—</strong><small>No Google data yet</small></>}</td>
                  <td data-label="Searches">{typeof item.volume === 'number' ? <><strong>{item.volume.toLocaleString('en-US')}</strong><small>estimated / month</small></> : <><strong>—</strong><small>Next KE refresh</small></>}</td>
                  <td data-label="Content">{item.url ? <a href={item.url}>{item.content}</a> : <strong>{item.content}</strong>}</td>
                  <td data-label="Status"><span class={`status status-${item.status.toLowerCase().replace(' ', '-')}`}>{item.status}</span></td>
                  <td data-label="Google activity">{metric ? <><strong>{metric.impressions.toLocaleString('en-US')} impressions</strong><small>{metric.clicks} clicks · {(metric.ctr * 100).toFixed(1)}% CTR</small></> : <span class="muted">Waiting for GSC</span>}</td>
                  <td data-label="Audience">{item.audience}</td>
                  <td data-label="Next step">{item.nextStep}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
        <p class="empty" hidden data-empty-state>No rows match this filter.</p>
      </div>
    </section>
  </main>

  <script>
    const search = document.querySelector('[data-tracker-search]');
    const buttons = [...document.querySelectorAll('[data-filter]')];
    const rows = [...document.querySelectorAll('[data-tracker-row]')];
    const empty = document.querySelector('[data-empty-state]');
    let activeFilter = 'All';
    const updateRows = () => {
      const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : '';
      let shown = 0;
      rows.forEach((row) => {
        if (!(row instanceof HTMLElement)) return;
        row.hidden = !((activeFilter === 'All' || row.dataset.status === activeFilter) && (!query || row.dataset.search?.includes(query)));
        if (!row.hidden) shown += 1;
      });
      if (empty instanceof HTMLElement) empty.hidden = shown !== 0;
    };
    buttons.forEach((button) => button.addEventListener('click', () => {
      if (!(button instanceof HTMLButtonElement)) return;
      activeFilter = button.dataset.filter ?? 'All';
      buttons.forEach((item) => item.classList.toggle('is-active', item === button));
      updateRows();
    }));
    search?.addEventListener('input', updateRows);
  </script>

  <style>
    :global(body) { background: #f4f1e9; color: #18231d; }
    .tracker-page { margin: 0 auto; max-width: 1800px; padding: 40px; }
    .page-header { align-items: end; border-bottom: 3px solid #173e32; display: flex; justify-content: space-between; padding-bottom: 26px; }
    .page-header > div > a { color: #285847; font-size: 18px; font-weight: 700; }
    h1 { color: #173e32; font-size: clamp(44px, 5vw, 72px); line-height: 1; margin: 16px 0 0; }
    .page-header nav { display: flex; gap: 12px; }
    .page-header nav a { background: #fff; border: 2px solid #b9b8ae; border-radius: 5px; color: #173e32; font-size: 17px; font-weight: 700; padding: 13px 18px; }
    .activity-section { margin: 30px 0; }
    .section-heading { align-items: end; display: flex; gap: 24px; justify-content: space-between; margin-bottom: 14px; }
    .section-heading h2 { color: #173e32; font-size: 36px; line-height: 1.1; margin: 0 0 7px; }
    .section-heading p { color: #4b5650; font-size: 17px; line-height: 1.45; margin: 0; }
    .activity-table-wrap { overflow-x: auto; }
    .activity-table { min-width: 760px; }
    .activity-table th:first-child { width: 46%; }
    .activity-table th:not(:first-child) { width: 18%; }
    .activity-table td { font-size: 18px; padding: 16px 18px; }
    .activity-table td > strong { font-size: 21px; }
    .summary { align-items: stretch; display: grid; gap: 12px; grid-template-columns: repeat(4, minmax(150px, 210px)) 1fr; margin: 24px 0; }
    .summary > div { align-items: center; background: #fff; border: 2px solid #d0cfc5; border-radius: 6px; display: flex; gap: 14px; padding: 17px 20px; }
    .summary > div strong { color: #173e32; font-family: var(--serif); font-size: 40px; font-weight: 500; line-height: 1; }
    .summary > div span { font-size: 17px; font-weight: 700; line-height: 1.2; }
    .summary p { align-self: center; color: #4b5650; font-size: 16px; line-height: 1.55; margin: 0; text-align: right; }
    .controls { align-items: end; background: #e9e5da; border: 2px solid #cbc8bc; display: flex; gap: 24px; justify-content: space-between; padding: 20px; }
    .controls label { display: grid; gap: 8px; font-size: 16px; font-weight: 700; }
    .controls input { background: #fff; border: 2px solid #999b94; border-radius: 4px; color: #18231d; font-size: 19px; min-height: 52px; padding: 0 14px; width: min(420px, 35vw); }
    .controls > div { display: flex; flex-wrap: wrap; gap: 8px; }
    .controls button { background: #fff; border: 2px solid #969a91; border-radius: 4px; color: #24352d; cursor: pointer; font-size: 16px; font-weight: 700; min-height: 48px; padding: 0 15px; }
    .controls button.is-active { background: #173e32; border-color: #173e32; color: #fff; }
    .rank-note { background: #fff; border: 2px solid #d0cfc5; border-top: 0; color: #46534c; font-size: 16px; line-height: 1.55; margin: 0; padding: 16px 20px; }
    .rank-note strong { color: #173e32; }
    .table-wrap { overflow-x: auto; }
    table { background: #fff; border-collapse: collapse; min-width: 1620px; width: 100%; }
    th { background: #173e32; border-right: 1px solid #46665c; color: #fff; font-size: 16px; line-height: 1.3; padding: 17px 14px; text-align: left; }
    td { border-bottom: 2px solid #d6d5cd; color: #29352f; font-size: 16px; line-height: 1.5; padding: 18px 14px; vertical-align: top; }
    tbody tr:nth-child(even) { background: #f7f6f1; }
    tbody tr:hover { background: #eef3ef; }
    th:nth-child(1) { width: 15%; } th:nth-child(2) { width: 11%; } th:nth-child(3) { width: 8%; } th:nth-child(4) { width: 14%; } th:nth-child(5) { width: 8%; } th:nth-child(6) { width: 11%; } th:nth-child(7) { width: 15%; }
    td strong, td a { color: #142b22; display: block; font-size: 17px; font-weight: 750; }
    td a { text-decoration-color: #bd6948; text-decoration-thickness: 2px; text-underline-offset: 4px; }
    td small { color: #5a655f; display: block; font-size: 14px; line-height: 1.4; margin-top: 5px; }
    .status { border-radius: 999px; display: inline-block; font-size: 14px; font-weight: 800; padding: 7px 11px; }
    .status-published { background: #dcece4; color: #18563c; }
    .status-planned { background: #e1e8f3; color: #294f80; }
    .status-needs-input { background: #f3e5c8; color: #71470d; }
    td .rank-number { color: #173e32; font-family: var(--serif); font-size: 34px; font-weight: 600; line-height: 1; }
    td .rank-empty { color: #737d77; font-size: 42px; }
    .rank-trend { display: block; font-size: 15px; font-weight: 800; margin-top: 8px; }
    .trend-up { color: #167345; }
    .trend-down { color: #a03d2f; }
    .trend-flat { color: #59645e; }
    .muted { color: #59645e; }
    .empty { font-size: 18px; padding: 40px; text-align: center; }
    @media (max-width: 900px) {
      .tracker-page { padding: 22px 16px; }
      .page-header { align-items: start; flex-direction: column; gap: 22px; }
      .page-header nav { width: 100%; }
      .page-header nav a { flex: 1; text-align: center; }
      .summary { grid-template-columns: repeat(2, 1fr); }
      .section-heading { align-items: start; flex-direction: column; }
      .activity-table { min-width: 700px; }
      .activity-table thead { display: table-header-group; }
      .activity-table tbody { display: table-row-group; }
      .activity-table tr { border: 0; border-radius: 0; display: table-row; margin: 0; overflow: visible; }
      .activity-table td { display: table-cell; }
      .activity-table td::before { display: none; }
      .summary p { grid-column: 1 / -1; text-align: left; }
      .controls { align-items: stretch; flex-direction: column; }
      .controls input { width: 100%; }
      .controls button { flex: 1 1 46%; }
      table { min-width: 0; }
      thead { display: none; }
      tbody, tr, td { display: block; }
      tr { border: 2px solid #b8bbb2; border-radius: 6px; margin: 16px 0; overflow: hidden; }
      td { align-items: start; display: grid; gap: 16px; grid-template-columns: 120px 1fr; padding: 15px; }
      td::before { color: #526059; content: attr(data-label); font-size: 14px; font-weight: 800; }
    }
    @media (max-width: 560px) {
      h1 { font-size: 46px; }
      .summary { grid-template-columns: 1fr; }
      .summary p { grid-column: auto; }
      td { grid-template-columns: 95px 1fr; }
    }
    @media print {
      :global(body) { background: #fff; }
      .tracker-page { max-width: none; padding: 0; }
      .controls, .page-header nav { display: none; }
    }
  </style>
</BaseLayout>
