---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeafMark from '../../components/LeafMark.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import { guides } from '../../data/guides';
import { getCollection } from 'astro:content';

const buildTime = new Date();
const generatedPosts = await getCollection(
  'journal',
  ({ data }) => !data.draft && data.publishedAt.valueOf() <= buildTime.valueOf(),
);
const generatedGuides = generatedPosts.map((post) => ({
  href: `/journal/${post.id}/`,
  title: post.data.title,
  excerpt: post.data.excerpt,
  category: post.data.category,
  date: post.data.publishedAt.toISOString().slice(0, 10),
  dateLabel: post.data.publishedAt.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }),
  image: post.data.image,
  imageAlt: post.data.imageAlt,
}));
const allGuides = [...generatedGuides, ...guides].sort((a, b) => b.date.localeCompare(a.date));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Raleigh Landscape & Garden Guides',
  description: 'Practical Raleigh landscape and garden guidance from Garden & Art Landscapes.',
  url: 'https://www.landscapingraleigh.com/journal/',
  hasPart: allGuides.map((guide) => ({ '@type': 'Article', headline: guide.title, url: `https://www.landscapingraleigh.com${guide.href}` })),
};
---

<BaseLayout title="Raleigh Landscape & Garden Guides | Garden & Art" description="Practical guides to Raleigh landscape design, drainage, clay soil, planting and garden care from horticulturist Norman Rabins." schema={schema}>
  <div class="journal-index-page">
    <a class="skip-link" href="#guides">Skip to guides</a>
    <header class="site-header is-scrolled" data-header>
      <a class="brand" href="/" aria-label="Garden and Art Landscapes home"><LeafMark class="brand-mark" /><span>Garden <i>&</i> Art</span></a>
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-button><span class="sr-only">Toggle navigation</span><span></span><span></span></button>
      <nav id="site-nav" class="site-nav" aria-label="Main navigation" data-nav><a href="/#work">Work</a><a href="/#services">Services</a><a href="/journal/" aria-current="page">Journal</a><a href="/#about">About</a><a href="/#contact">Contact</a></nav>
      <a class="header-call" href="tel:+19192352245">919 235 2245</a>
    </header>

    <main id="guides">
      <header class="journal-index-hero">
        <p class="eyebrow">Field notes for Raleigh landscapes</p>
        <h1>Practical guidance.<br /><em>Rooted in place.</em></h1>
        <p>Clear answers about planting, drainage, design and care—grounded in Raleigh conditions and Garden & Art's horticultural perspective.</p>
      </header>

      <section class="journal-index-grid section-pad" aria-label="Landscape and garden guides">
        {allGuides.map((guide, index) => (
          <article class:list={['guide-card', { featured: index === 0 }]}>
            <a class="guide-card-image" href={guide.href}><img src={guide.image} alt={guide.imageAlt} width="1200" height="900" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" /></a>
            <div class="guide-card-copy">
              <p class="eyebrow">{guide.category} · <time datetime={guide.date}>{guide.dateLabel}</time></p>
              <h2><a href={guide.href}>{guide.title}</a></h2>
              <p>{guide.excerpt}</p>
              <a class="text-link" href={guide.href}>Read the guide <ArrowIcon /></a>
            </div>
          </article>
        ))}
      </section>

      <section class="journal-index-cta">
        <div><p class="eyebrow light">Have a site-specific question?</p><h2>Bring the guide<br /><em>into your garden.</em></h2></div>
        <a class="button button-clay" href="/#contact">Tell us about your property <ArrowIcon /></a>
      </section>
    </main>

    <footer class="site-footer"><div class="footer-brand"><LeafMark /><span>Garden <i>&</i> Art Landscapes</span></div><p>Serving Raleigh, Durham, Chapel Hill, Cary, Holly Springs and surrounding communities.</p><div class="footer-meta"><span>© {new Date().getFullYear()} Garden & Art Landscapes</span><span>NC Landscape Contractor #1901 · Bonded & insured</span><a href="/privacy/">Privacy</a><a href="/#contact">Contact</a></div></footer>
  </div>

  <script>
    const button = document.querySelector('[data-menu-button]');
    const nav = document.querySelector('[data-nav]');
    button?.addEventListener('click', () => { const open = button.getAttribute('aria-expanded') === 'true'; button.setAttribute('aria-expanded', String(!open)); nav?.classList.toggle('is-open', !open); });
    nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { button?.setAttribute('aria-expanded', 'false'); nav.classList.remove('is-open'); }));
  </script>
</BaseLayout>
